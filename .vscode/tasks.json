{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure Debug",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset", "Debug"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "CMake: Build Debug",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "Debug"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": []
        },
        {
            "label": "DAPLink: Flash ELF",
            "type": "process",
            "command": "openocd.exe",
            "args": [
                "-s",
                "C:/Tools/openocd/openocd/scripts",
                "-f",
                "interface/cmsis-dap.cfg",
                "-f",
                "target/stm32h7x.cfg",
                "-c",
                "transport select swd",
                "-c",
                "adapter speed 1000",
                "-c",
                "program build/Debug/robot_arm.elf verify reset exit"
            ],
            "options": {"cwd": "${workspaceFolder}"},
            "presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
            "problemMatcher": []
        },
        {
            "label": "DAPLink: Build and Flash",
            "dependsOrder": "sequence",
            "dependsOn": ["CMake: Build Debug", "DAPLink: Flash ELF"],
            "problemMatcher": []
        }
    ]
}
